{
  "name": "botsupply",
  "version": "1.0.0",
  "private": true,
  "description": "Wholesale marketplace API where AI agents buy products with prepaid credits.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test tests/api.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
